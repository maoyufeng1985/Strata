# cmake -DLLAMA=<llama.cpp dir> -DOUT=<scratch dir> [-DPATCH=ON|OFF] -P cmake/ggml_sm61_mmq_overlay_test.cmake
# The sm_61 MMQ config overlay on a pinned llama.cpp: every copied header equals the pinned file byte for byte,
# except mmq-config-pascal-dp4a.cuh under -DPATCH=ON - which is the verbatim #31352 result (a known SHA-256,
# 22 new rows) there - and is byte-identical to the pinned one with -DPATCH=OFF (the ctest proof of a
# STRATA_MMQ_SM61_CONFIG=OFF build: the copied .cuh equals the pinned file).
# a -P script has no cmake_minimum_required, so CMake 3.x applies the OLD CMP0057 - set it, as the TQ test does
cmake_policy(SET CMP0057 NEW)
include(${CMAKE_CURRENT_LIST_DIR}/strata_ggml_sm61_mmq_overlay.cmake)
file(REMOVE_RECURSE "${OUT}")
strata_ggml_sm61_mmq_overlay("${LLAMA}" "${OUT}" "${PATCH}")
if(NOT STRATA_SM61_MMQ_OVERLAY_OK)
  message(FATAL_ERROR "overlay did not generate on ${LLAMA}")
endif()
set(CU "${LLAMA}/ggml/src/ggml-cuda")
set(_pin_hash 67a93b6d26d3e16e77fd285dd77e7cca7848fb0b0d68897c2ff1e8cc47102263)
set(_patch_hash 375327932e07aad5b02024aee93aa45e675f5f63abd3cbe83bf84351b9789f81)
file(READ "${CU}/mmq-config-pascal-dp4a.cuh" _o)
string(SHA256 _o_hash "${_o}")
if(NOT _o_hash STREQUAL _pin_hash)
  message(FATAL_ERROR "the pinned mmq-config-pascal-dp4a.cuh is not the 3cf03257f file (${_o_hash}): the test needs the pinned tree")
endif()
# ---- every copied header equals the pinned one, except the intended CASE file under PATCH=ON -------------------
file(GLOB _cuh "${CU}/*.cuh" "${CU}/*.h")
foreach(_f IN LISTS _cuh)
  get_filename_component(_n "${_f}" NAME)
  if(NOT EXISTS "${OUT}/${_n}")
    message(FATAL_ERROR "the overlay has no copy of ${_n}")
  endif()
  file(READ "${_f}" _a)
  file(READ "${OUT}/${_n}" _b)
  if(_n STREQUAL "mmq-config-pascal-dp4a.cuh")
    if(PATCH STREQUAL "ON")
      string(SHA256 _b_hash "${_b}")
      if(NOT _b_hash STREQUAL _patch_hash)
        message(FATAL_ERROR "the patched mmq-config-pascal-dp4a.cuh hashes to ${_b_hash}, not the #31352 result")
      endif()
    else()
      if(NOT _a STREQUAL _b)
        message(FATAL_ERROR "mmq-config-pascal-dp4a.cuh: the unpatched (STRATA_MMQ_SM61_CONFIG=OFF) copy differs from the pinned file")
      endif()
    endif()
    continue()
  endif()
  if(NOT _a STREQUAL _b)
    message(FATAL_ERROR "${_n} differs from the pinned file but is not meant to")
  endif()
endforeach()
# ---- the applied-diff checklist: the two J=64 rows (fallback true/false) of the 11 types, I=64 -> I=128 -------
if(PATCH STREQUAL "ON")
  file(READ "${OUT}/mmq-config-pascal-dp4a.cuh" _n_txt)
  foreach(_pl Q1_0|Q8_0;Q2_0|Q8_0;Q4_0|Q8_0;Q4_1|Q8_1;Q5_0|Q8_0;Q5_1|Q8_1;Q8_0|Q8_0;IQ2_XXS|Q8_0;IQ3_XXS|Q8_0;IQ4_XS|Q8_0;IQ4_NL|Q8_0)
    string(REPLACE "|" ";" _pp "${_pl}")
    list(GET _pp 0 _ty)
    list(GET _pp 1 _l)
    foreach(_fb IN ITEMS true false)
      set(_old "    CASE(GGML_TYPE_${_ty}, 256, 2, 64,  64, GGML_CUDA_MMQ_SRAM_LAYOUT_${_l}, MMQ_ITER_K, false, ${_fb});")
      set(_new "    CASE(GGML_TYPE_${_ty}, 256, 2, 128,  64, GGML_CUDA_MMQ_SRAM_LAYOUT_${_l}, MMQ_ITER_K, false, ${_fb});")
      string(FIND "${_n_txt}" "${_old}" _p1)
      if(NOT _p1 LESS 0)
        message(FATAL_ERROR "an old #31352 row survived: ${_old}")
      endif()
      string(FIND "${_n_txt}" "${_new}" _p2)
      if(_p2 LESS 0)
        message(FATAL_ERROR "a new #31352 row is missing: ${_new}")
      endif()
    endforeach()
  endforeach()
endif()
message(STATUS "ggml_sm61_mmq_overlay_test: ok")
